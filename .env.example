# Copy to .env and fill locally. This repository ships no key and no member address.
# Nothing is broadcast unless you run forge script with --broadcast.

# Required by script/DeployInfrastructure.s.sol and script/DeployIssuerKit.s.sol.
# A 32-byte hex private key you control. Leave empty in git.
DEPLOYER_PRIVATE_KEY=

# Script gate. Infrastructure script expects deploy-gv-infrastructure.
# Issuer-kit script expects deploy-gv-kit.
GV_CONFIRM=

# Public Base RPC. Used by the fork test and, if you choose, by a script you run.
# Leave empty to skip the fork test. A public endpoint is enough. Do not put a key in the URL if you can avoid it.
BASE_RPC_URL=

# Only for the verification commands in docs/gv-without-investhub.md. Not read by the contracts.
BASESCAN_API_KEY=

# Issuer kit parameters. See docs/gv-without-investhub.md.
GV_FACTORY=
GV_TOKEN_MODE=native
GV_NAME=
GV_SYMBOL=
GV_GOV_NAME=
GV_DECIMALS=0
GV_SUPPLY=
GV_METADATA_URI=
GV_SALT=
GV_VOTING_DELAY=86400
GV_VOTING_PERIOD=604800
GV_PROPOSAL_THRESHOLD=1
GV_QUORUM_NUMERATOR=50
GV_TIMELOCK_DELAY=172800
GV_EXISTING_UNDERLYING=
GV_EXISTING_VOTES=
